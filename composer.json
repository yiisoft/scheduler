{
    "name": "yiisoft/scheduler",
    "type": "library",
    "description": "Recurring tasks and cron-style scheduling for PHP, best used with Yii3",
    "keywords": ["yii", "schedule", "scheduler", "cron", "recurring tasks"],
    "homepage": "https://www.yiiframework.com/",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/scheduler/issues?state=open",
        "source": "https://github.com/yiisoft/scheduler",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "8.1 - 8.5",
        "dragonmantank/cron-expression": "^3.1",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92.5",
        "phpunit/phpunit": "^10.5.46",
        "rector/rector": "^2.0.17",
        "roave/infection-static-analysis-plugin": "^1.35",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spatie/phpunit-watcher": "^1.24.0",
        "vimeo/psalm": "^5.26.1 || ^6.12",
        "yiisoft/mutex": "^1.1",
        "yiisoft/queue": "dev-master"
    },
    "suggest": {
        "yiisoft/mutex": "To prevent overlapping runs across processes.",
        "yiisoft/queue": "To push due tasks to a queue instead of running them in the scheduler process.",
        "ext-pcntl": "To handle signals and run due tasks in parallel in the schedule:work command.",
        "ext-posix": "To stop forked task processes gracefully when schedule:work shuts down."
    },
    "autoload": {
        "psr-4": {
            "Yiisoft\\Scheduler\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Scheduler\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "composer/package-versions-deprecated": false,
            "yiisoft/config": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --no-interaction",
        "test-watch": "phpunit-watcher watch",
        "dependency-analyser": "composer-dependency-analyser"
    }
}
