{
    "name": "yiisoft/scheduler",
    "type": "library",
    "description": "Recurring tasks and cron-style scheduling for PHP, best used with Yii3",
    "keywords": ["yii", "schedule", "scheduler", "cron", "recurring tasks"],
    "homepage": "https://www.yiiframework.com/",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/scheduler/issues?state=open",
        "source": "https://github.com/yiisoft/scheduler",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "8.1 - 8.5",
        "dragonmantank/cron-expression": "^3.1",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/process": "^6.4",
        "yiisoft/injector": "^1.0"
    },
    "suggest": {
        "ext-mbstring": "Required by the default SQLite execution ledger adapter.",
        "ext-pdo_sqlite": "Required by the default SQLite execution ledger adapter.",
        "yiisoft/db": "Required for the default SQLite execution ledger.",
        "yiisoft/db-sqlite": "Required for the default SQLite execution ledger."
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92.5",
        "phpunit/phpunit": "^10.5.46",
        "infection/infection": "^0.28.1",
        "rector/rector": "^2.0.17",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spatie/phpunit-watcher": "^1.24.0",
        "vimeo/psalm": "^6.16",
        "yiisoft/db": "^2.0",
        "yiisoft/db-sqlite": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Yiisoft\\Scheduler\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Scheduler\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "infection/extension-installer": true
        }
    },
    "extra": {"branch-alias": {"dev-master": "1.0.x-dev"}},
    "scripts": {
        "test": "phpunit --testdox --display-warnings --display-deprecations",
        "test-watch": "phpunit-watcher watch",
        "dependency-analyser": "composer-dependency-analyser"
    },
    "bin": ["bin/scheduler"]
}
